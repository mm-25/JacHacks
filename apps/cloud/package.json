{
  "name": "sherry-cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "../../.venv/bin/jac run build.jac",
    "dev": "npm run build && wrangler dev",
    "db:local": "wrangler d1 migrations apply sherry --local",
    "db:remote": "wrangler d1 migrations apply sherry --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.141.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0"
  }
}
