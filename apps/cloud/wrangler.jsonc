{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sherry",
  "main": "src/index.js",
  "compatibility_date": "2026-09-26",
  // The web app (apps/web, static build) is served from the same address;
  // /function/* is the API and always runs the Worker.
  "assets": {
    "directory": "../web/.jac/client/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/function/*", "/mcp", "/mcp/*", "/.well-known/*", "/register", "/authorize", "/token", "/revoke"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sherry",
      "database_id": "d49cf96e-520b-4c00-8a66-62b26f36ff23",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // https://<project>.supabase.co - Supabase project that owns the logins.
    "SUPABASE_URL": "https://uddwarzmnyuktwgzvbpd.supabase.co",
    // Publishable key (safe to share): lets the connector sign-in page check
    // email + password with Supabase.
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_00WzhaTLVhUsZpIAYg9Ytg_ZwQlMNRp"
  }
  // Secrets (set with `npx wrangler secret put <NAME>`, never in this file):
  //   ANTHROPIC_API_KEY    enables Claude-written chat summaries
  //   SUPABASE_JWT_SECRET  only for Supabase projects on the legacy HS256 secret
}
