{
  "manifest_version": 3,
  "name": "Sherry Web Scraper",
  "version": "1.0",
  "description": "Passively scrapes ChatGPT and Claude.ai web chats to your local Sherry memory layer.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "*://chatgpt.com/*",
    "*://claude.ai/*",
    "http://localhost:3001/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://chatgpt.com/*", "*://claude.ai/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
